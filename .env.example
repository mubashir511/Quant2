# MT5 terminal login (leave USE_MOCK_DATA=1 to skip these entirely)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Set to 1 to use synthetic positions instead of a live MT5 connection
USE_MOCK_DATA=1

# Rebalance rule thresholds
MAX_LOSS_PCT=10
MAX_POSITION_COUNT=6
MAX_SYMBOL_EXPOSURE_PCT=30

# Free OpenRouter API key (https://openrouter.ai/keys) for the gpt-oss-20b
# and Nemotron-Ultra models that audit Claude's own draft portfolio
# suggestion
OPENROUTER_API_KEY=

# "Apply Suggestion" places real MT5 orders. Leave at 0 unless MT5_SERVER
# is a demo account or you explicitly intend to allow live execution.
ALLOW_LIVE_EXECUTION=0

# Optional: path to the CSV produced by mql5/DumpSymbolSpecs.mq5 (run
# inside the MT5 terminal itself), used as a fallback contract-spec source
# when the live MT5 Python API has nothing for a symbol. Leave blank to
# disable.
MT5_SYMBOL_SPECS_CSV_PATH=
